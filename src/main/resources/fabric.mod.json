    "sources": "https://github.com/Maeiro/Serene-Seasons-Better-Winter"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/serenebetterwinter/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.serenebetterwinter.mod.WinterMod"],
    "client": ["com.serenebetterwinter.mod.WinterClient"]
  },
  "mixins": ["serenebetterwinter.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
